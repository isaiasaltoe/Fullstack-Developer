<h1>Import Users</h1>

<%= form_with url: import_admin_users_path, local: true, html: { multipart: true } do |f| %>
  <div>
    <%= f.label :file, "Choose the file, CSV or XLSX" %>
    <%= f.file_field :file %>
  </div>

  <div style="margin-top: 10px;">
    <%= f.submit "Import", class: "button" %>
  </div>
<% end %>
